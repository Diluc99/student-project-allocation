<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_ProjectAllocation" name="Student Project Approval and Allocation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collaboration_Project">
    <bpmn:participant id="Participant_Programme" name="Final-Year Project Programme" processRef="student_project_allocation" />
  </bpmn:collaboration>
  <bpmn:process id="student_project_allocation" name="Student Project Approval and Allocation" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_S" name="Student / Team">
        <bpmn:flowNodeRef>Start_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ReviseTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LapsedRevise</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_M" name="Project Management System">
        <bpmn:flowNodeRef>Task_FlagLate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_LateTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_LateMsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyLapse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Team</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyInvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvalidTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Similarity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Sim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_NewTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Allocation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_NoGuide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_After</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyNoGuide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoGuide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_C" name="Project Coordinator">
        <bpmn:flowNodeRef>Task_LateDecide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_LateDec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LateDenied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CoordResolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Unresolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SimReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SimDec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_R" name="Review Committee (incl. HoD)">
        <bpmn:flowNodeRef>Gw_JoinReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Reminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_JoinDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Limit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G" name="Faculty Guide" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Submit" name="Team decides to submit proposal">
      <bpmn:documentation>Happy path start. Initialises loop counters and thresholds used by the failure paths.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=0" target="validationAttempts" />
          <zeebe:output source="=0" target="revisionCycles" />
          <zeebe:output source="=1" target="newTopicAllowance" />
          <zeebe:output source="=0" target="guideAttempts" />
          <zeebe:output source="=[]" target="excludedGuides" />
          <zeebe:output source="=&#34;none&#34;" target="withdrawalBy" />
          <zeebe:output source="=0.4" target="similarityThreshold" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>F_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Submit" name="Submit project proposal">
      <bpmn:documentation>Happy path. Human task: the team fills in the proposal form.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="students" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_01</bpmn:incoming>
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_Deadline" name="Deadline passed" attachedToRef="Task_Submit">
      <bpmn:documentation>F4 - Proposal deadline. Interrupting timer on the submission task.</bpmn:documentation>
      <bpmn:outgoing>F_03</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Boundary_Deadline">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_Revise" name="Revise &#38; resubmit (or new topic)">
      <bpmn:documentation>Shared rework task used by F1 (validation errors), F3 (modify topic), F5 (committee revision) and F6 (one new topic).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="students" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_22</bpmn:incoming>
      <bpmn:incoming>F_31</bpmn:incoming>
      <bpmn:incoming>F_47</bpmn:incoming>
      <bpmn:incoming>F_49</bpmn:incoming>
      <bpmn:outgoing>F_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_ReviseTimer" name="7 days" attachedToRef="Task_Revise">
      <bpmn:documentation>F12 - Team does not rework within 7 days. Interrupting timer, case lapses.</bpmn:documentation>
      <bpmn:outgoing>F_13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Boundary_ReviseTimer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_LapsedRevise" name="Closed: revision lapsed">
      <bpmn:incoming>F_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_FlagLate" name="Flag team &#38; notify deadline missed">
      <bpmn:documentation>F4 - Notify the team that the deadline was missed and that a late-submission request is possible.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_03</bpmn:incoming>
      <bpmn:outgoing>F_04</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gw_Late" name="Late request?">
      <bpmn:documentation>F4 - Event-based gateway: late-submission request message OR 3-day timer, whichever comes first.</bpmn:documentation>
      <bpmn:incoming>F_04</bpmn:incoming>
      <bpmn:outgoing>F_05</bpmn:outgoing>
      <bpmn:outgoing>F_06</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_LateTimer" name="3 days, no request">
      <bpmn:incoming>F_05</bpmn:incoming>
      <bpmn:outgoing>F_07</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Catch_LateTimer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_LateMsg" name="Late request received">
      <bpmn:incoming>F_06</bpmn:incoming>
      <bpmn:outgoing>F_09</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Catch_LateMsg" messageRef="Message_late" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_NotifyLapse" name="Notify team: proposal lapsed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_07</bpmn:incoming>
      <bpmn:outgoing>F_08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Lapsed" name="Closed: lapsed (no submission)">
      <bpmn:incoming>F_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Validate" name="Validate form &#38; team rules">
      <bpmn:documentation>Happy path. Checks completeness, roll numbers, team size and double membership. Sets formValid, teamValid, errorList.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-proposal" />
        <zeebe:ioMapping>
          <zeebe:output source="=validationAttempts + 1" target="validationAttempts" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F_02</bpmn:incoming>
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Team" name="Team rules OK?" default="F_16">
      <bpmn:documentation>F2 - Team size / duplicate membership.</bpmn:documentation>
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_16</bpmn:outgoing>
      <bpmn:outgoing>F_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyInvalid" name="Notify team: invalid team">
      <bpmn:documentation>F2 - Reject at validation; the team is reformed and files a new proposal.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_17</bpmn:incoming>
      <bpmn:outgoing>F_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_InvalidTeam" name="Closed: invalid team">
      <bpmn:incoming>F_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Form" name="Form complete?" default="F_21">
      <bpmn:documentation>F1 - Form validation outcome with a loop limit of 2 resubmissions.</bpmn:documentation>
      <bpmn:incoming>F_16</bpmn:incoming>
      <bpmn:outgoing>F_19</bpmn:outgoing>
      <bpmn:outgoing>F_20</bpmn:outgoing>
      <bpmn:outgoing>F_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_ReturnErrors" name="Return proposal with error list">
      <bpmn:documentation>F1 - Return to team with the error list.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_19</bpmn:incoming>
      <bpmn:outgoing>F_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_Similarity" name="Run similarity / duplicate check">
      <bpmn:documentation>Happy path. Compares topic/abstract with earlier projects, sets similarityScore.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="similarity-check" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_26</bpmn:incoming>
      <bpmn:outgoing>F_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Sim" name="Similarity above threshold?" default="F_29">
      <bpmn:documentation>F3 - Duplicate / plagiarised topic.</bpmn:documentation>
      <bpmn:incoming>F_27</bpmn:incoming>
      <bpmn:outgoing>F_28</bpmn:outgoing>
      <bpmn:outgoing>F_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Reminder" name="Send reminder to committee">
      <bpmn:documentation>F7 - Non-interrupting reminder after 5 days.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_35</bpmn:incoming>
      <bpmn:outgoing>F_36</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Reminder" name="Reminder sent">
      <bpmn:incoming>F_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_SendRevision" name="Send revision feedback to team">
      <bpmn:documentation>F5 - Counts the revision cycle and resets the validation counter.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
        <zeebe:ioMapping>
          <zeebe:output source="=revisionCycles + 1" target="revisionCycles" />
          <zeebe:output source="=0" target="validationAttempts" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F_45</bpmn:incoming>
      <bpmn:outgoing>F_47</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_NotifyReject" name="Notify team: rejected, with reasons">
      <bpmn:documentation>F3/F6 - Sends the reasons and consumes the single new-topic allowance.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
        <zeebe:ioMapping>
          <zeebe:output source="=newTopicAllowance - 1" target="newTopicAllowance" />
          <zeebe:output source="=0" target="validationAttempts" />
          <zeebe:output source="=0" target="revisionCycles" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F_32</bpmn:incoming>
      <bpmn:incoming>F_43</bpmn:incoming>
      <bpmn:outgoing>F_48</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gw_NewTopic" name="New topic still allowed?" default="F_50">
      <bpmn:documentation>F6 - One new topic submission is allowed; after that the case ends as Rejected.</bpmn:documentation>
      <bpmn:incoming>F_48</bpmn:incoming>
      <bpmn:outgoing>F_49</bpmn:outgoing>
      <bpmn:outgoing>F_50</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="Closed: rejected">
      <bpmn:incoming>F_50</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_LateDecide" name="Decide on late submission">
      <bpmn:documentation>F4 - Coordinator approves or denies the late submission request.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="coordinators" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_09</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_LateDec" name="Late submission approved?" default="F_12">
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_11</bpmn:outgoing>
      <bpmn:outgoing>F_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_LateDenied" name="Closed: late request denied">
      <bpmn:incoming>F_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_CoordResolve" name="Resolve validation issues with team">
      <bpmn:documentation>F1 - Escalation after 2 failed resubmissions.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="coordinators" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_20</bpmn:incoming>
      <bpmn:outgoing>F_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Resolved" name="Resolved?" default="F_25">
      <bpmn:incoming>F_23</bpmn:incoming>
      <bpmn:outgoing>F_24</bpmn:outgoing>
      <bpmn:outgoing>F_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Unresolved" name="Closed: validation unresolved">
      <bpmn:incoming>F_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Screen" name="Screen proposal">
      <bpmn:documentation>Happy path. Coordinator screens scope and format.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="coordinators" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_21</bpmn:incoming>
      <bpmn:incoming>F_24</bpmn:incoming>
      <bpmn:outgoing>F_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SimReview" name="Review similarity match">
      <bpmn:documentation>F3 - Coordinator inspects the match and records the decision (modify / reject / cleared).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="coordinators" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_28</bpmn:incoming>
      <bpmn:outgoing>F_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_SimDec" name="Coordinator decision?" default="F_33">
      <bpmn:documentation>F3 - Both outcomes are recorded in simDecision.</bpmn:documentation>
      <bpmn:incoming>F_30</bpmn:incoming>
      <bpmn:outgoing>F_31</bpmn:outgoing>
      <bpmn:outgoing>F_32</bpmn:outgoing>
      <bpmn:outgoing>F_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_JoinReview">
      <bpmn:incoming>F_29</bpmn:incoming>
      <bpmn:incoming>F_33</bpmn:incoming>
      <bpmn:incoming>F_46</bpmn:incoming>
      <bpmn:outgoing>F_34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Review" name="Evaluate proposal">
      <bpmn:documentation>Happy path. Committee evaluates; result in variable decision (approved / revise / rejected).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="review-committee" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_34</bpmn:incoming>
      <bpmn:outgoing>F_40</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_Reminder" name="5 days" cancelActivity="false" attachedToRef="Task_Review">
      <bpmn:documentation>F7 - Non-interrupting reminder.</bpmn:documentation>
      <bpmn:outgoing>F_35</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Boundary_Reminder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Escalate" name="10 days" attachedToRef="Task_Review">
      <bpmn:documentation>F7 - Interrupting escalation: the HoD takes over the decision.</bpmn:documentation>
      <bpmn:outgoing>F_37</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Boundary_Escalate">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Throw_Escalate" name="Escalate to HoD">
      <bpmn:incoming>F_37</bpmn:incoming>
      <bpmn:outgoing>F_38</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="EscDef_Throw_Escalate" escalationRef="Escalation_hod" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Task_HoD" name="HoD decides on proposal">
      <bpmn:documentation>F7 - Head of Department makes the overdue decision.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="hod" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_38</bpmn:incoming>
      <bpmn:outgoing>F_39</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_JoinDecision">
      <bpmn:incoming>F_39</bpmn:incoming>
      <bpmn:incoming>F_40</bpmn:incoming>
      <bpmn:outgoing>F_41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Decision" name="Committee decision?" default="F_44">
      <bpmn:documentation>Exclusive gateway: approved / revise / rejected.</bpmn:documentation>
      <bpmn:incoming>F_41</bpmn:incoming>
      <bpmn:outgoing>F_42</bpmn:outgoing>
      <bpmn:outgoing>F_43</bpmn:outgoing>
      <bpmn:outgoing>F_44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Limit" name="Revision limit reached?" default="F_46">
      <bpmn:documentation>F5 - At most 2 revision cycles; then the committee must approve or reject.</bpmn:documentation>
      <bpmn:incoming>F_44</bpmn:incoming>
      <bpmn:outgoing>F_45</bpmn:outgoing>
      <bpmn:outgoing>F_46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_Allocation" name="Guide allocation &#38; confirmation">
      <bpmn:documentation>Scope of F8-F11. Contains the allocation rule, guide acceptance, recording and notification. Message event sub-process = withdrawal (F11).</bpmn:documentation>
      <bpmn:incoming>F_42</bpmn:incoming>
      <bpmn:incoming>F_55</bpmn:incoming>
      <bpmn:outgoing>F_51</bpmn:outgoing>
      <bpmn:startEvent id="A_Start" name="Allocation approved">
        <bpmn:outgoing>A_01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="A_JoinLoad">
        <bpmn:incoming>A_01</bpmn:incoming>
        <bpmn:incoming>A_12</bpmn:incoming>
        <bpmn:incoming>A_22</bpmn:incoming>
        <bpmn:outgoing>A_02</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_Load" name="Load guide roster &#38; workloads">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="load-guide-roster" />
        </bpmn:extensionElements>
        <bpmn:incoming>A_02</bpmn:incoming>
        <bpmn:outgoing>A_03</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:businessRuleTask id="A_Rule" name="Check guide availability &#38; workload">
        <bpmn:documentation>Business rule task (DMN guide-allocation.dmn): domain match + workload + exclusion list.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:calledDecision decisionId="allocationResult" resultVariable="allocation" />
        </bpmn:extensionElements>
        <bpmn:incoming>A_03</bpmn:incoming>
        <bpmn:outgoing>A_04</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="A_Gw1" name="Guide available?" default="A_06">
        <bpmn:documentation>F8 - Business rule returned NONE.</bpmn:documentation>
        <bpmn:incoming>A_04</bpmn:incoming>
        <bpmn:outgoing>A_05</bpmn:outgoing>
        <bpmn:outgoing>A_06</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="A_JoinRes">
        <bpmn:incoming>A_05</bpmn:incoming>
        <bpmn:incoming>A_08</bpmn:incoming>
        <bpmn:outgoing>A_14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_Reserve" name="Allocate guide (reserve slot)">
        <bpmn:documentation>Reserves a slot in the guide workload. Has a compensation handler (F11).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="reserve-guide-slot" />
        </bpmn:extensionElements>
        <bpmn:incoming>A_14</bpmn:incoming>
        <bpmn:outgoing>A_15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="A_BoundaryComp" attachedToRef="A_Reserve">
        <bpmn:compensateEventDefinition id="CompDef_A_BoundaryComp" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="A_Release" name="Release guide slot" isForCompensation="true">
        <bpmn:documentation>F11 - Compensation handler: frees the reserved guide slot.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="release-guide-slot" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:sendTask id="A_SendReq" name="Send allocation request to guide">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-notification" />
        </bpmn:extensionElements>
        <bpmn:incoming>A_15</bpmn:incoming>
        <bpmn:outgoing>A_16</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="A_Wait" name="Accept or decline allocation request">
        <bpmn:documentation>Guide response (variable guideResponse = accept / decline).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="faculty-guides" />
        </bpmn:extensionElements>
        <bpmn:incoming>A_16</bpmn:incoming>
        <bpmn:outgoing>A_17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="A_BoundaryTimer" name="5 days" attachedToRef="A_Wait">
        <bpmn:documentation>F9 - Silent guide: after 5 days the request is treated as declined.</bpmn:documentation>
        <bpmn:outgoing>A_20</bpmn:outgoing>
        <bpmn:timerEventDefinition id="Timer_A_BoundaryTimer">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="A_Gw4" name="Guide response?" default="A_19">
        <bpmn:incoming>A_17</bpmn:incoming>
        <bpmn:outgoing>A_18</bpmn:outgoing>
        <bpmn:outgoing>A_19</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_Decline" name="Record decline, release slot, exclude guide">
        <bpmn:documentation>F9 - Exclude the guide and count the attempt.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-guide-decline" />
          <zeebe:ioMapping>
            <zeebe:output source="=guideAttempts + 1" target="guideAttempts" />
            <zeebe:output source="=append(excludedGuides, allocation.guideId)" target="excludedGuides" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>A_19</bpmn:incoming>
        <bpmn:incoming>A_20</bpmn:incoming>
        <bpmn:outgoing>A_21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A_Gw5" name="Fewer than 3 attempts?" default="A_23">
        <bpmn:documentation>F9 - After 3 attempts the coordinator allocates manually.</bpmn:documentation>
        <bpmn:incoming>A_21</bpmn:incoming>
        <bpmn:outgoing>A_22</bpmn:outgoing>
        <bpmn:outgoing>A_23</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="A_NoneFound" name="Allocate manually, co-guide, external or waiting list">
        <bpmn:documentation>F8/F9 - Coordinator resolves the case. Output: coordDecision (assign / waitlist) and allocation.guideId.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="coordinators" />
        </bpmn:extensionElements>
        <bpmn:incoming>A_06</bpmn:incoming>
        <bpmn:incoming>A_23</bpmn:incoming>
        <bpmn:outgoing>A_07</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="A_Gw2" name="Coordinator decision?" default="A_08">
        <bpmn:incoming>A_07</bpmn:incoming>
        <bpmn:outgoing>A_08</bpmn:outgoing>
        <bpmn:outgoing>A_09</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:eventBasedGateway id="A_GwWait" name="Wait for capacity">
        <bpmn:incoming>A_09</bpmn:incoming>
        <bpmn:outgoing>A_10</bpmn:outgoing>
        <bpmn:outgoing>A_11</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="A_CatchCap" name="Guide capacity freed">
        <bpmn:incoming>A_10</bpmn:incoming>
        <bpmn:outgoing>A_12</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MsgDef_A_CatchCap" messageRef="Message_capacity" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="A_CatchTimer" name="30 days">
        <bpmn:incoming>A_11</bpmn:incoming>
        <bpmn:outgoing>A_13</bpmn:outgoing>
        <bpmn:timerEventDefinition id="Timer_A_CatchTimer">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="A_EndNoGuide" name="No guide in 30 days">
        <bpmn:incoming>A_13</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrDef_A_EndNoGuide" errorRef="Error_noguide" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="A_Record" name="Record allocation in system">
        <bpmn:documentation>F10 - Retries 3 times, then the worker throws DB_WRITE_ERROR.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="record-allocation" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>A_18</bpmn:incoming>
        <bpmn:outgoing>A_24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="A_BoundaryDb" name="DB error" attachedToRef="A_Record">
        <bpmn:documentation>F10 - fallback to manual.</bpmn:documentation>
        <bpmn:outgoing>A_26</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrDef_A_BoundaryDb" errorRef="Error_db" />
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="A_Notify" name="Notify student of allocation">
        <bpmn:documentation>F10 - Retries 3 times, then the worker throws NOTIFICATION_FAILED.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-notification" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>A_24</bpmn:incoming>
        <bpmn:outgoing>A_25</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:boundaryEvent id="A_BoundaryNotify" name="E-mail error" attachedToRef="A_Notify">
        <bpmn:documentation>F10 - fallback to manual.</bpmn:documentation>
        <bpmn:outgoing>A_27</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrDef_A_BoundaryNotify" errorRef="Error_notify" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="A_Manual" name="Coordinator records / notifies manually">
        <bpmn:documentation>F10 - Manual fallback after retries are exhausted.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="coordinators" />
        </bpmn:extensionElements>
        <bpmn:incoming>A_26</bpmn:incoming>
        <bpmn:incoming>A_27</bpmn:incoming>
        <bpmn:outgoing>A_28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="A_End" name="Guide confirmed">
        <bpmn:incoming>A_25</bpmn:incoming>
        <bpmn:incoming>A_28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="Esub_Withdraw" name="Withdrawal by team or guide" triggeredByEvent="true">
        <bpmn:documentation>F11 - Interrupting message event sub-process (team dissolves / guide on leave).</bpmn:documentation>
        <bpmn:startEvent id="E_Start" name="Withdrawal received">
          <bpmn:outgoing>E_01</bpmn:outgoing>
          <bpmn:messageEventDefinition id="MsgDef_E_Start" messageRef="Message_withdraw" />
        </bpmn:startEvent>
        <bpmn:serviceTask id="E_Record" name="Record withdrawal (team / guide)">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="record-withdrawal" />
            <zeebe:ioMapping>
              <zeebe:output source="=withdrawalSource" target="withdrawalBy" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>E_01</bpmn:incoming>
          <bpmn:outgoing>E_02</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:intermediateThrowEvent id="E_Comp" name="Release guide slot">
          <bpmn:incoming>E_02</bpmn:incoming>
          <bpmn:outgoing>E_03</bpmn:outgoing>
          <bpmn:compensateEventDefinition id="CompDef_E_Comp" />
        </bpmn:intermediateThrowEvent>
        <bpmn:endEvent id="E_End" name="Scope closed">
          <bpmn:incoming>E_03</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="E_01" sourceRef="E_Start" targetRef="E_Record" />
        <bpmn:sequenceFlow id="E_02" sourceRef="E_Record" targetRef="E_Comp" />
        <bpmn:sequenceFlow id="E_03" sourceRef="E_Comp" targetRef="E_End" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="A_01" sourceRef="A_Start" targetRef="A_JoinLoad" />
      <bpmn:sequenceFlow id="A_02" sourceRef="A_JoinLoad" targetRef="A_Load" />
      <bpmn:sequenceFlow id="A_03" sourceRef="A_Load" targetRef="A_Rule" />
      <bpmn:sequenceFlow id="A_04" sourceRef="A_Rule" targetRef="A_Gw1" />
      <bpmn:sequenceFlow id="A_05" name="Found" sourceRef="A_Gw1" targetRef="A_JoinRes">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=allocation.status = "AVAILABLE"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A_06" name="None" sourceRef="A_Gw1" targetRef="A_NoneFound" />
      <bpmn:sequenceFlow id="A_07" sourceRef="A_NoneFound" targetRef="A_Gw2" />
      <bpmn:sequenceFlow id="A_08" name="Assign manually / co-guide / external" sourceRef="A_Gw2" targetRef="A_JoinRes" />
      <bpmn:sequenceFlow id="A_09" name="Waiting list" sourceRef="A_Gw2" targetRef="A_GwWait">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=coordDecision = "waitlist"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A_10" sourceRef="A_GwWait" targetRef="A_CatchCap" />
      <bpmn:sequenceFlow id="A_11" sourceRef="A_GwWait" targetRef="A_CatchTimer" />
      <bpmn:sequenceFlow id="A_12" sourceRef="A_CatchCap" targetRef="A_JoinLoad" />
      <bpmn:sequenceFlow id="A_13" sourceRef="A_CatchTimer" targetRef="A_EndNoGuide" />
      <bpmn:sequenceFlow id="A_14" sourceRef="A_JoinRes" targetRef="A_Reserve" />
      <bpmn:sequenceFlow id="A_15" sourceRef="A_Reserve" targetRef="A_SendReq" />
      <bpmn:sequenceFlow id="A_16" sourceRef="A_SendReq" targetRef="A_Wait" />
      <bpmn:sequenceFlow id="A_17" sourceRef="A_Wait" targetRef="A_Gw4" />
      <bpmn:sequenceFlow id="A_18" name="Accepts" sourceRef="A_Gw4" targetRef="A_Record">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=guideResponse = "accept"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A_19" name="Declines" sourceRef="A_Gw4" targetRef="A_Decline" />
      <bpmn:sequenceFlow id="A_20" sourceRef="A_BoundaryTimer" targetRef="A_Decline" />
      <bpmn:sequenceFlow id="A_21" sourceRef="A_Decline" targetRef="A_Gw5" />
      <bpmn:sequenceFlow id="A_22" name="Yes: retry rule" sourceRef="A_Gw5" targetRef="A_JoinLoad">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=guideAttempts &lt; 3</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="A_23" name="No: 3 attempts used" sourceRef="A_Gw5" targetRef="A_NoneFound" />
      <bpmn:sequenceFlow id="A_24" sourceRef="A_Record" targetRef="A_Notify" />
      <bpmn:sequenceFlow id="A_25" sourceRef="A_Notify" targetRef="A_End" />
      <bpmn:sequenceFlow id="A_26" sourceRef="A_BoundaryDb" targetRef="A_Manual" />
      <bpmn:sequenceFlow id="A_27" sourceRef="A_BoundaryNotify" targetRef="A_Manual" />
      <bpmn:sequenceFlow id="A_28" sourceRef="A_Manual" targetRef="A_End" />
      <bpmn:association id="Assoc_Comp" associationDirection="None" sourceRef="A_BoundaryComp" targetRef="A_Release" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_NoGuide" name="No guide" attachedToRef="Sub_Allocation">
      <bpmn:documentation>F8 - Waiting-list timeout.</bpmn:documentation>
      <bpmn:outgoing>F_56</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Boundary_NoGuide" errorRef="Error_noguide" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gw_After" name="Allocation outcome?" default="F_52">
      <bpmn:documentation>F11 - Evaluates withdrawalBy: guide -&gt; re-allocate, team -&gt; close, none -&gt; success.</bpmn:documentation>
      <bpmn:incoming>F_51</bpmn:incoming>
      <bpmn:outgoing>F_52</bpmn:outgoing>
      <bpmn:outgoing>F_53</bpmn:outgoing>
      <bpmn:outgoing>F_54</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Prep" name="Exclude withdrawn guide, reset counters">
      <bpmn:documentation>F11 - Returns the team to the allocation step.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="=true" resultVariable="prepared" />
        <zeebe:ioMapping>
          <zeebe:output source="=append(excludedGuides, allocation.guideId)" target="excludedGuides" />
          <zeebe:output source="=0" target="guideAttempts" />
          <zeebe:output source="=&#34;none&#34;" target="withdrawalBy" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F_53</bpmn:incoming>
      <bpmn:outgoing>F_55</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_OK" name="Project allocated">
      <bpmn:incoming>F_52</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Withdrawn" name="Closed: withdrawn">
      <bpmn:incoming>F_54</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_NotifyNoGuide" name="Notify team &#38; coordinator: no guide">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_56</bpmn:incoming>
      <bpmn:outgoing>F_57</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_NoGuide" name="Closed: no guide available">
      <bpmn:incoming>F_57</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_01" sourceRef="Start_Submit" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="F_02" sourceRef="Task_Submit" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="F_03" sourceRef="Boundary_Deadline" targetRef="Task_FlagLate" />
    <bpmn:sequenceFlow id="F_04" sourceRef="Task_FlagLate" targetRef="Gw_Late" />
    <bpmn:sequenceFlow id="F_05" sourceRef="Gw_Late" targetRef="Catch_LateTimer" />
    <bpmn:sequenceFlow id="F_06" sourceRef="Gw_Late" targetRef="Catch_LateMsg" />
    <bpmn:sequenceFlow id="F_07" sourceRef="Catch_LateTimer" targetRef="Task_NotifyLapse" />
    <bpmn:sequenceFlow id="F_08" sourceRef="Task_NotifyLapse" targetRef="End_Lapsed" />
    <bpmn:sequenceFlow id="F_09" sourceRef="Catch_LateMsg" targetRef="Task_LateDecide" />
    <bpmn:sequenceFlow id="F_10" sourceRef="Task_LateDecide" targetRef="Gw_LateDec" />
    <bpmn:sequenceFlow id="F_11" name="Yes" sourceRef="Gw_LateDec" targetRef="Task_Submit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=lateApproved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_12" name="No" sourceRef="Gw_LateDec" targetRef="End_LateDenied" />
    <bpmn:sequenceFlow id="F_13" sourceRef="Boundary_ReviseTimer" targetRef="End_LapsedRevise" />
    <bpmn:sequenceFlow id="F_14" sourceRef="Task_Revise" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="F_15" sourceRef="Task_Validate" targetRef="Gw_Team" />
    <bpmn:sequenceFlow id="F_16" name="Yes" sourceRef="Gw_Team" targetRef="Gw_Form" />
    <bpmn:sequenceFlow id="F_17" name="No" sourceRef="Gw_Team" targetRef="Task_NotifyInvalid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(teamValid)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_18" sourceRef="Task_NotifyInvalid" targetRef="End_InvalidTeam" />
    <bpmn:sequenceFlow id="F_19" name="Incomplete, attempts &#60; 2" sourceRef="Gw_Form" targetRef="Task_ReturnErrors">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(formValid) and validationAttempts &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_20" name="Incomplete, attempts &#62;= 2" sourceRef="Gw_Form" targetRef="Task_CoordResolve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(formValid) and validationAttempts &gt;= 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_21" name="Complete" sourceRef="Gw_Form" targetRef="Task_Screen" />
    <bpmn:sequenceFlow id="F_22" sourceRef="Task_ReturnErrors" targetRef="Task_Revise" />
    <bpmn:sequenceFlow id="F_23" sourceRef="Task_CoordResolve" targetRef="Gw_Resolved" />
    <bpmn:sequenceFlow id="F_24" name="Yes" sourceRef="Gw_Resolved" targetRef="Task_Screen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resolved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_25" name="No" sourceRef="Gw_Resolved" targetRef="End_Unresolved" />
    <bpmn:sequenceFlow id="F_26" sourceRef="Task_Screen" targetRef="Task_Similarity" />
    <bpmn:sequenceFlow id="F_27" sourceRef="Task_Similarity" targetRef="Gw_Sim" />
    <bpmn:sequenceFlow id="F_28" name="Yes" sourceRef="Gw_Sim" targetRef="Task_SimReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=similarityScore &gt; similarityThreshold</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_29" name="No" sourceRef="Gw_Sim" targetRef="Gw_JoinReview" />
    <bpmn:sequenceFlow id="F_30" sourceRef="Task_SimReview" targetRef="Gw_SimDec" />
    <bpmn:sequenceFlow id="F_31" name="Modify topic" sourceRef="Gw_SimDec" targetRef="Task_Revise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=simDecision = "modify"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_32" name="Reject" sourceRef="Gw_SimDec" targetRef="Task_NotifyReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=simDecision = "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_33" name="Cleared" sourceRef="Gw_SimDec" targetRef="Gw_JoinReview" />
    <bpmn:sequenceFlow id="F_34" sourceRef="Gw_JoinReview" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F_35" sourceRef="Boundary_Reminder" targetRef="Task_Reminder" />
    <bpmn:sequenceFlow id="F_36" sourceRef="Task_Reminder" targetRef="End_Reminder" />
    <bpmn:sequenceFlow id="F_37" sourceRef="Boundary_Escalate" targetRef="Throw_Escalate" />
    <bpmn:sequenceFlow id="F_38" sourceRef="Throw_Escalate" targetRef="Task_HoD" />
    <bpmn:sequenceFlow id="F_39" sourceRef="Task_HoD" targetRef="Gw_JoinDecision" />
    <bpmn:sequenceFlow id="F_40" sourceRef="Task_Review" targetRef="Gw_JoinDecision" />
    <bpmn:sequenceFlow id="F_41" sourceRef="Gw_JoinDecision" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="F_42" name="Approved" sourceRef="Gw_Decision" targetRef="Sub_Allocation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_43" name="Rejected" sourceRef="Gw_Decision" targetRef="Task_NotifyReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_44" name="Revise" sourceRef="Gw_Decision" targetRef="Gw_Limit" />
    <bpmn:sequenceFlow id="F_45" name="No, cycles &#60; 2" sourceRef="Gw_Limit" targetRef="Task_SendRevision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=revisionCycles &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_46" name="Yes: approve or reject only" sourceRef="Gw_Limit" targetRef="Gw_JoinReview" />
    <bpmn:sequenceFlow id="F_47" sourceRef="Task_SendRevision" targetRef="Task_Revise" />
    <bpmn:sequenceFlow id="F_48" sourceRef="Task_NotifyReject" targetRef="Gw_NewTopic" />
    <bpmn:sequenceFlow id="F_49" name="Yes" sourceRef="Gw_NewTopic" targetRef="Task_Revise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=newTopicAllowance &gt;= 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_50" name="No" sourceRef="Gw_NewTopic" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F_51" sourceRef="Sub_Allocation" targetRef="Gw_After" />
    <bpmn:sequenceFlow id="F_52" name="No withdrawal" sourceRef="Gw_After" targetRef="End_OK" />
    <bpmn:sequenceFlow id="F_53" name="Guide withdrew" sourceRef="Gw_After" targetRef="Task_Prep">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=withdrawalBy = "guide"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_54" name="Team withdrew" sourceRef="Gw_After" targetRef="End_Withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=withdrawalBy = "team"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_55" sourceRef="Task_Prep" targetRef="Sub_Allocation" />
    <bpmn:sequenceFlow id="F_56" sourceRef="Boundary_NoGuide" targetRef="Task_NotifyNoGuide" />
    <bpmn:sequenceFlow id="F_57" sourceRef="Task_NotifyNoGuide" targetRef="End_NoGuide" />
  </bpmn:process>
